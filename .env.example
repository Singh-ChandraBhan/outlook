APP_MODE=local
DATA_DIR=data
OUTLOOK_DESKTOP_MAILBOX=

AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=knowledge-json

AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=enterprise-knowledge
AZURE_SEARCH_API_KEY=

AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
EMBEDDING_DIMENSIONS=1536

GRAPH_TENANT_ID=<entra-tenant-id>
GRAPH_CLIENT_ID=<entra-application-client-id>
GRAPH_CLIENT_SECRET=<client-secret>
GRAPH_USER_ID=<mailbox-upn-or-object-id>
GRAPH_TEAM_ID=<team-id>
GRAPH_CHANNEL_ID=<channel-id>
NOTIFICATION_EMAIL=<alert-recipient>
TEAMS_WEBHOOK_URL=<teams-workflows-webhook-url>
CALENDAR_DAYS_PAST=7
CALENDAR_DAYS_FUTURE=30

SERVICENOW_URL=https://<instance>.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident
